# Public site URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.asircontainers.com

# Google SMTP configuration for send-enquiry.php / /api/enquiry
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail, generate a 16-character App Password (Google Account > Security > 2-Step Verification > App Passwords)
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
NOTIFICATION_EMAIL=sales@asircontainers.com
